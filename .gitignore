# Secrets — never commit these
.env

# Python cache
__pycache__/
*.pyc
*.pyo

# Runtime databases — contain live user data, never commit
*.db
tmp_*/

# Stray logs from local testing
*.log

# Battle music lives in the poke-music S3 bucket, not the repo
web/static/audio/

# Artwork thumbnails generated by the web app (web/main.py /img/art)
web/.thumbs/
