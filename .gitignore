# Secrets — never commit these
.env
lavalink/application.yml

# Lavalink binaries — download separately on the server
lavalink/Lavalink.jar
lavalink/plugins/

# Python cache
__pycache__/
*.pyc
*.pyo

# Spotipy token cache
.cache

# Runtime databases — contain live user data, never commit
*.db
tmp_*/

# Stray logs from local testing
*.log

# Battle music lives in the poke-music S3 bucket, not the repo
web/static/audio/
