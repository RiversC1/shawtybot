server:
  port: 2333
  address: 0.0.0.0

lavalink:
  plugins:
    - dependency: "dev.lavalink.youtube:youtube-plugin:1.18.1"
      repository: "https://maven.lavalink.dev/releases"
    - dependency: "com.github.topi314.lavasrc:lavasrc-plugin:4.8.2"
      repository: "https://maven.topi.wtf/releases"
  server:
    password: "shawtybot"
    sources:
      youtube: false
      soundcloud: true
      bandcamp: true
      twitch: true

plugins:
  lavasrc:
    providers:
      - 'ytsearch:"%ISRC%"'
      - "ytsearch:%QUERY%"
    sources:
      spotify:
        clientId: "your_spotify_client_id_here"
        clientSecret: "your_spotify_client_secret_here"
        countryCode: "US"
        playlistLoadLimit: 6
        albumLoadLimit: 6
  youtube:
    oauth:
      enabled: true
      refreshToken: "your_youtube_oauth_refresh_token_here"

logging:
  level:
    lavalink: INFO
